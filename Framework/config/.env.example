# 环境变量示例。请复制为 config/.env 后填写。切勿提交真实密钥。
# TODO: 请在此处配置 API Key 或环境变量。

# ---- LLM ----
LLM_PROVIDER=openai
MODEL_NAME=
# TODO: 在此填写 API Key（或在部署环境注入同名环境变量）
OPENAI_API_KEY=
# 兼容 OpenAI 协议的服务可填写 base_url，留空使用官方默认
OPENAI_BASE_URL=
LLM_TEMPERATURE=0.0

# ---- 记忆库 / IO ----
MEMORY_DB_PATH=memory.db
INPUT_FILE=examples/input/sample.c
OUTPUT_PATH=output/final_report.json

# ---- 其他 ----
MAX_RETRIES=3
LOG_ENABLED=true
