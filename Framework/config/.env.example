# 环境变量示例。请复制为 config/.env 后填写。切勿提交真实密钥。
# TODO: 请在此处配置 API Key 或环境变量。

# ---- LLM ----
LLM_PROVIDER=openai
MODEL_NAME=gpt
# TODO: 在此填写 API Key（或在部署环境注入同名环境变量）
OPENAI_API_KEY=
# 兼容 OpenAI 协议的服务可填写 base_url，留空使用官方默认
OPENAI_BASE_URL=
LLM_TEMPERATURE=0.0

# ---- 记忆库 / IO ----
MEMORY_DB_PATH=memory.db
INPUT_FILE=examples/input/sample.c
OUTPUT_PATH=output/final_report.json

# ---- 其他 ----
MAX_RETRIES=3
LOG_ENABLED=true

# ---- D 阶段第二阶段核验开关（应用层，优先级高于下方工具进程级变量）----
# 动态执行：仅对内存类 CWE（越界/UAF/双释放/溢出等）在沙箱内编译运行；关闭后不触发编译/运行
VERIFY_DYNAMIC_ENABLED=true
# 注入类源码核验：命令注入 78 / SQL 注入 89 / XSS 79 的静态 sink 与直达核验
VERIFY_INJECTION_ENABLED=true

# ---- 动态工具进程级兜底（仅当上面 VERIFY_*_ENABLED 未显式设置时生效）----
# DYNCHECK_ENABLED=1
# DYNCHECK_MAX_ITER=24        # 变异种子数上限
# DYNCHECK_TIMEOUT=5          # 单进程运行超时秒数
# DYNCHECK_TOTAL_TIMEOUT=60   # 单条 finding 全部种子的运行总预算秒数
# DYNCHECK_COVERAGE=0         # 1=编译带 --coverage；llvm-cov 导出 .gcov、行级覆盖解析、增量排序与第二轮邻域变异候选已接线实测
# DYNCHECK_DOCKER=auto        # auto=探测到 docker 即用容器；on/off 强制
# DYNCHECK_CC=               # 显式指定 C 编译器全路径（便携 LLVM-MinGW clang 等）；缺省按 PATH 探测 clang→gcc
# DYNCHECK_SEED=0             # 变异随机种子；固定默认值保证离线可复现，改值换一批变异样本
# 动态种子来源：配置了 OPENAI_API_KEY 时由 LLM 定向生成调用种子（排在启发式前合并去重）；
# 无 Key / 调用失败时回退纯启发式变异种子，不阻塞主流程。
# INJCHECK_ENABLED=1
# INJRUNTIME_ENABLED=0        # 注入探针运行时复现（命令 canary 探针），默认关闭待调通
